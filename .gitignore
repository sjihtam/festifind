.DS_Store
node_modules/

# Nothing secret lives in this repo. src/config.js holds only a Spotify Client
# ID, which is public by design under PKCE — it is meant to be committed, so the
# hosted copy works for the people you invite.

# Local Claude Code settings — machine-specific, not part of the app.
.claude/settings.local.json
.claude/launch.json

# Recorded Spotify snapshot (?record mode) — the user's personal listening
# data, used by tools/replay.mjs for offline tuning. Never commit.
data-snapshot.json

# Generated review page (tools/replay.mjs --html): same personal data, rendered.
review.html
